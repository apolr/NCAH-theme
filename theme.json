{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "black",
					"name": "Black",
					"color": "#101510"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "grey",
					"name": "Grey",
					"color": "#4a524a"
				},
				{
					"slug": "ncah-green",
					"name": "NCAH Green",
					"color": "#008000"
				},
				{
					"slug": "ncah-green-dark",
					"name": "NCAH Green dark",
					"color": "#005f00"
				},
				{
					"slug": "ncah-red",
					"name": "NCAH Red",
					"color": "#d42402"
				},
				{
					"slug": "ncah-red-dark",
					"name": "NCAH Red dark",
					"color": "#a81b00"
				},
				{
					"slug": "mist",
					"name": "Alternate section background",
					"color": "#f3f7f3"
				},
				{
					"slug": "ncah-green-tint",
					"name": "NCAH Green tint",
					"color": "#e8f3e8"
				},
				{
					"slug": "ncah-red-tint",
					"name": "NCAH Red tint",
					"color": "#fdeeea"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Fira Sans",
					"fontFamily": "\"Fira Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-latin-500-normal.woff2"
							]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-latin-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Fira Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fira-sans-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Fira Sans (headings)",
					"fontFamily": "\"Fira Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Heading 2",
					"size": "clamp(1.5rem, 1.25rem + 0.9vw, 1.75rem)"
				},
				{
					"slug": "x-large",
					"name": "Heading 1",
					"size": "clamp(1.875rem, 1.5rem + 1.4vw, 2.5rem)"
				},
				{
					"slug": "hero",
					"name": "Display",
					"size": "clamp(2.25rem, 1.5rem + 3vw, 3.5rem)"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "S",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "3rem"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "5rem"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "8rem"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "1.2",
					"fontWeight": "600"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ncah-green)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ncah-green-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ncah-red)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "8px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"fontSize": "0.9375rem",
					"textTransform": "none",
					"letterSpacing": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.7em",
						"bottom": "0.7em",
						"left": "1.4em",
						"right": "1.4em"
					}
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "elementor_header_footer",
			"title": "Full width (carried over from the old site)",
			"postTypes": [
				"page"
			]
		}
	]
}